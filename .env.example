# Required for model inference via Gradient serverless API
GRADIENT_MODEL_ACCESS_KEY=replace_with_your_key

# Optional override. As of 2026-03, openai-gpt-oss-120b is a common default.
GRADIENT_MODEL_ID=openai-gpt-oss-120b
GRADIENT_BASE_URL=https://inference.do-ai.run/v1/

# Embedding model for semantic search (uses same base URL and API key)
GRADIENT_EMBEDDING_MODEL_ID=text-embedding-3-small

# Managed PostgreSQL connection string (with pgvector extension)
DATABASE_URL=postgresql://user:password@host:25060/meaning_map?sslmode=require

# Required only for deploy commands (not local run)
DIGITALOCEAN_API_TOKEN=replace_with_digitalocean_api_token
